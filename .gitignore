# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets — .env.example is the exception,
# and must only ever contain variable names, no real values)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite database
/dev.db
/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# local-only AI agent tooling (auto-installed reference docs/settings,
# not part of the application)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
