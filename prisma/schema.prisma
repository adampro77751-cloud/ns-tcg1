// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

// Auth-relevant, private account data. Never expose passwordHash or email
// through public APIs/pages.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile PlayerProfile?

  ownedSprites   SpriteInstance[]
  redeemedCodes  RedemptionCode[] @relation("RedeemedBy")
  createdSpriteCodeBatches SpriteCodeBatch[]
  decks          Deck[]
  matchPlayers   MatchPlayer[]

  wonMatches       MatchResult[] @relation("MatchWinner")
  lostMatches      MatchResult[] @relation("MatchLoser")
  submittedResults MatchResult[] @relation("SubmittedBy")
  confirmedResults MatchResult[] @relation("ConfirmedBy")

  organizedEvents Event[]       @relation("Organizer")
  wonEvents       Event[]       @relation("EventWinner")
  eventPlayers    EventPlayer[]
}

// Public-facing profile data, separate from auth/account data so it is safe
// to join into public pages. Stats (wins/losses/etc.) are intentionally NOT
// stored here — they are derived at query time from Match/MatchResult/Event
// records, which are the single source of truth. This avoids counters ever
// drifting out of sync and means a result can't accidentally get "applied"
// twice.
model PlayerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cards & Sprites
// ---------------------------------------------------------------------------

model Card {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  set        String?
  cardNumber String?
  type       String?
  rarity     String?
  attack     Int?
  defence    Int?
  speed      Int?
  rulesText  String?
  image      String?
  createdAt  DateTime @default(now())

  deckCards        DeckCard[]
  bannedInFormats      FormatBannedCard[]
  restrictedInFormats  FormatRestrictedCard[]
  matchDeckSnapshots   MatchPlayerDeckCard[]
}

enum SpriteRarity {
  RARE
  MYTHIC
  LEGENDARY
}

model Sprite {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  rarity      SpriteRarity?
  description String?
  rulesText   String?
  image       String?
  set         String?
  releaseDate DateTime?
  createdAt   DateTime      @default(now())

  // Per-level ability text (Level 1-5, matching MAX_SPRITE_LEVEL in
  // src/lib/xp.ts). Null where a Sprite's abilities aren't yet known —
  // never guessed. Kept as five plain fields rather than a JSON blob since
  // the level count is fixed and this keeps them simple to select/display.
  level1Ability String?
  level2Ability String?
  level3Ability String?
  level4Ability String?
  level5Ability String?

  instances       SpriteInstance[]
  redemptionCodes RedemptionCode[]
  codeBatches     SpriteCodeBatch[]
}

// A print/release edition of a Sprite (e.g. "1st Edition"). Kept as its own
// model — rather than folded into Sprite.name or a free-text field — so the
// same Sprite can have multiple editions over time (reprints, later sets)
// without renaming or duplicating the Sprite row.
model Edition {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  spriteInstances SpriteInstance[]
  redemptionCodes RedemptionCode[]
  codeBatches     SpriteCodeBatch[]
}

enum SpriteObtainMethod {
  REDEMPTION_CODE
  ADMIN_GRANT
  UNKNOWN
}

enum SpriteHistoryEventType {
  OBTAINED
  RENAMED
  LEVEL_UP
  MATCH_PLAYED
  MATCH_WON
  XP_GAINED
}

// An individually owned Sprite. Every redeemed/obtained Sprite is its own
// row with its own identity, custom name, level, and history — NOT a
// quantity counter. Owning three Fire Sprites means three SpriteInstance
// rows, each independently nameable and (eventually) independently
// levelling.
model SpriteInstance {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spriteId  String
  sprite    Sprite   @relation(fields: [spriteId], references: [id], onDelete: Cascade)
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id])

  // Player-given nickname. Defaults to the base Sprite's name when the
  // instance is created; the base type/rarity/edition always remain
  // visible via the `sprite`/`edition` relations regardless of nickname.
  name String

  // Level is always derived server-side from `xp` via levelForXp() in
  // src/lib/xp.ts — never trust a client-submitted level. Capped at 5
  // (MAX_SPRITE_LEVEL) both by that derivation and by the DB-level CHECK
  // constraint added in the add_progression migration, so no request path
  // (including direct SQL) can push a Sprite above Level 5.
  level Int @default(1)
  // Total accumulated XP from confirmed match wins/losses of the equipped
  // Sprite. Keeps increasing after Level 5 is reached (visible on the
  // Sprite's page) but never causes a level above 5.
  xp    Int @default(0)

  obtainedMethod SpriteObtainMethod @default(UNKNOWN)
  obtainedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  history        SpriteHistoryEntry[]
  redemptionCode RedemptionCode?
  matchPlayers   MatchPlayer[]
  eventPlayers   EventPlayer[]

  @@index([ownerId])
  @@index([spriteId])
}

// Append-only, server-generated activity log for one SpriteInstance.
// `detail` is structured JSON (shape depends on `type`) rather than
// free-text, so it stays machine-readable and the event set can grow
// later (e.g. LEVEL_UP once real levelling rules exist) without a schema
// change. Never populated from client-submitted data.
model SpriteHistoryEntry {
  id               String                 @id @default(cuid())
  spriteInstanceId String
  spriteInstance   SpriteInstance         @relation(fields: [spriteInstanceId], references: [id], onDelete: Cascade)
  type             SpriteHistoryEventType
  detail           Json
  createdAt        DateTime               @default(now())

  @@index([spriteInstanceId])
}

// A batch of RedemptionCodes generated together by an admin for a specific
// Sprite + Edition print run, e.g. "Fire Sprite — 1st Edition, 100 codes".
model SpriteCodeBatch {
  id          String   @id @default(cuid())
  spriteId    String
  sprite      Sprite   @relation(fields: [spriteId], references: [id])
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id])
  quantity    Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  codes RedemptionCode[]

  @@index([createdById])
}

// Redemption codes unlock a specific Sprite+Edition exactly once. `code` is
// a securely randomly generated string (not sequential/guessable), unique
// at the database level. Designed so a QR code can simply encode a URL like
// /redeem?code=NS-XXXX-XXXX that lands on the same redemption flow — no
// separate QR architecture needed.
model RedemptionCode {
  id           String    @id @default(cuid())
  code         String    @unique
  spriteId     String
  sprite       Sprite    @relation(fields: [spriteId], references: [id])
  editionId    String
  edition      Edition   @relation(fields: [editionId], references: [id])
  batchId      String
  batch        SpriteCodeBatch @relation(fields: [batchId], references: [id])
  redeemed     Boolean   @default(false)
  redeemedById String?
  redeemedBy   User?     @relation("RedeemedBy", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  // The individual SpriteInstance this code created, once redeemed —
  // preserves exactly which code produced which owned Sprite.
  spriteInstanceId String?         @unique
  spriteInstance    SpriteInstance? @relation(fields: [spriteInstanceId], references: [id])

  @@index([redeemedById])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Formats & Decks
// ---------------------------------------------------------------------------

// Format rules are data, not code. `allowedSets` is a JSON-encoded string
// array (null/empty = all sets allowed); banned/restricted cards are proper
// relations. The actual legality *evaluation* lives in reusable TS logic
// (src/lib/legality.ts), not duplicated across UI components.
model Format {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  description      String?
  minDeckSize      Int
  maxDeckSize      Int?
  maxCopiesPerCard Int
  // Real, authoritative match-setup values for this format (not display
  // text) — read by match creation/join so a match actually starts with
  // the right hand size/health for its format instead of duplicating these
  // numbers across components.
  startingHand     Int
  startingHealth   Int
  allowedSets      String? // JSON string array, null = all sets allowed
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  bannedCards     FormatBannedCard[]
  restrictedCards FormatRestrictedCard[]
  decks           Deck[]
  matches         Match[]
  events          Event[]
}

model FormatBannedCard {
  id       String @id @default(cuid())
  formatId String
  format   Format @relation(fields: [formatId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reason   String?

  @@unique([formatId, cardId])
}

// Restricted = legal but capped below the format's normal max-copies rule
// (e.g. a 1-of "restricted list", in case NS TCG wants that later).
model FormatRestrictedCard {
  id        String @id @default(cuid())
  formatId  String
  format    Format @relation(fields: [formatId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  maxCopies Int

  @@unique([formatId, cardId])
}

model Deck {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formatId  String
  format    Format   @relation(fields: [formatId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards        DeckCard[]
  matchPlayers MatchPlayer[]
  eventPlayers EventPlayer[]

  @@index([userId])
}

model DeckCard {
  id       String @id @default(cuid())
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int    @default(1)

  @@unique([deckId, cardId])
}

// ---------------------------------------------------------------------------
// Matches
// ---------------------------------------------------------------------------

enum MatchStatus {
  WAITING // created, waiting for an opponent to join
  IN_PROGRESS // both players joined
  AWAITING_CONFIRMATION // a result has been submitted, waiting on confirmation
  COMPLETED
  CANCELLED
}

model Match {
  id         String      @id @default(cuid())
  joinCode   String      @unique
  formatId   String
  format     Format      @relation(fields: [formatId], references: [id])
  status     MatchStatus @default(WAITING)
  createdAt  DateTime    @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // Normal (public) matches are listed for anyone to join directly;
  // private matches are reachable only via their direct link/join code,
  // same as every match behaved before this field existed — hence
  // defaulting to true, so no existing match becomes newly public.
  isPrivate Boolean @default(true)

  // Set when this Match is one round of an Event's best-of-X series
  // (Event.bestOf) — null for a standalone match. onDelete: SetNull since
  // Events are never deleted, but keeps this safe regardless.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  players MatchPlayer[]
  result  MatchResult?

  @@index([eventId])
}

model MatchPlayer {
  id       String   @id @default(cuid())
  matchId  String
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  deckId   String
  deck     Deck     @relation(fields: [deckId], references: [id])

  // The individual owned SpriteInstance this player equipped for the match,
  // if any — "No Sprite" is represented as null, a legitimate first-class
  // state, not the absence of a decision. Always validated server-side
  // against session ownership before being set (see match-actions.ts);
  // never trusted from client input. onDelete: SetNull so a historical
  // match survives even if the Sprite instance it referenced were ever
  // removed.
  spriteInstanceId String?
  spriteInstance    SpriteInstance? @relation(fields: [spriteInstanceId], references: [id], onDelete: SetNull)

  joinedAt DateTime @default(now())

  // Immutable snapshot of exactly which cards (and how many copies) this
  // player's Deck contained at the moment they joined this match — see
  // deckCardSnapshot below.
  deckCardSnapshot MatchPlayerDeckCard[]

  @@unique([matchId, userId])
  @@index([userId])
  @@index([spriteInstanceId])
}

// A frozen copy of one MatchPlayer's DeckCard list, written once (at
// MatchPlayer creation — see snapshotMatchPlayerDeck in
// src/lib/match-deck-snapshot.ts) and never updated afterward. Decks are
// mutable — a player can add/remove cards from a Deck at any time — so
// metagame card win-rate statistics can NEVER be computed by joining a
// completed Match to a Deck's current DeckCard rows; that would silently
// rewrite history every time someone edited a deck. This table is the
// only reliable record of "which cards did this player actually have in
// their deck for this specific match", and only matches with a snapshot
// are eligible for card win-rate statistics (see src/lib/metagame.ts).
model MatchPlayerDeckCard {
  id            String      @id @default(cuid())
  matchPlayerId String
  matchPlayer   MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card        @relation(fields: [cardId], references: [id])
  quantity      Int

  @@unique([matchPlayerId, cardId])
  @@index([matchPlayerId])
  @@index([cardId])
}

enum ResultStatus {
  PENDING // submitted by one player, awaiting confirmation
  CONFIRMED // confirmed by the other player — stats now count this match
  DISPUTED // the other player rejected the submitted result
}

// Submit/confirm flow for result integrity: one player submits, the other
// must confirm before it counts. A Match has at most one MatchResult
// (1:1), and only a CONFIRMED result is ever counted in stats queries — so
// there is no separate "already applied" flag to keep in sync.
model MatchResult {
  id            String       @id @default(cuid())
  matchId       String       @unique
  match         Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerId      String
  winner        User         @relation("MatchWinner", fields: [winnerId], references: [id])
  loserId       String?
  loser         User?        @relation("MatchLoser", fields: [loserId], references: [id])
  submittedById String
  submittedBy   User         @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime     @default(now())
  confirmedById String?
  confirmedBy   User?        @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  status        ResultStatus @default(PENDING)

  // Set exactly once, in the same transaction that flips PENDING ->
  // CONFIRMED, right after Sprite XP is awarded for this match. A second,
  // independent guard (on top of that atomic status transition, which by
  // itself can only ever fire once per match) against ever awarding XP for
  // the same match twice — via double confirmation, replay, or concurrency.
  xpAwardedAt DateTime?

  @@index([winnerId])
  @@index([loserId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

enum EventStatus {
  REGISTRATION // organiser can still accept joiners
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Deliberately simple for v1 (organiser declares a winner once the event is
// done) but structured so Swiss/elimination pairings & standings can be
// layered on later without a schema rewrite: EventPlayer already tracks
// per-player participation, and Match already supports being played inside
// an event context via future FK — see notes in docs.
model Event {
  id          String      @id @default(cuid())
  name        String
  joinCode    String      @unique
  organizerId String
  organizer   User        @relation("Organizer", fields: [organizerId], references: [id])
  formatId    String
  format      Format      @relation(fields: [formatId], references: [id])
  maxPlayers  Int
  status      EventStatus @default(REGISTRATION)
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  winnerId    String?
  winner      User?       @relation("EventWinner", fields: [winnerId], references: [id])

  // When set (an odd number: 1, 3, 5, 7), this event is a head-to-head
  // best-of-`bestOf` series between its exactly 2 players, played as real
  // tracked Matches (see Match.eventId) — the winner is derived
  // automatically once a player's confirmed round wins reach
  // ceil(bestOf/2), never manually declared. Null keeps the original v1
  // behaviour: the organiser manually declares a winner. Enforced
  // server-side that bestOf can only be set when maxPlayers = 2.
  bestOf Int?

  // Set exactly once, in the same transaction that declares/derives a
  // winner and moves the Event to COMPLETED — mirrors
  // MatchResult.xpAwardedAt as a guard against ever awarding Sprite XP for
  // the same event twice.
  xpAwardedAt DateTime?

  players EventPlayer[]
  matches Match[]

  @@index([organizerId])
}

model EventPlayer {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  deckId   String?
  deck     Deck?    @relation(fields: [deckId], references: [id])

  // The individual owned SpriteInstance this player equipped for the
  // event, if any — same "No Sprite is legitimate, always validated
  // server-side against ownership" rules as MatchPlayer.spriteInstanceId.
  spriteInstanceId String?
  spriteInstance    SpriteInstance? @relation(fields: [spriteInstanceId], references: [id], onDelete: SetNull)

  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([spriteInstanceId])
}
