# Copy this file to .env and fill in real values. Never commit the real .env.

# Prisma datasource connection string. Locally this points at a SQLite file;
# in production point it at your actual database (see deployment notes).
DATABASE_URL="file:./dev.db"

# Auth.js session encryption secret. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production — the app will not start without it.
AUTH_SECRET=""
