# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string (Prisma datasource). Works with any hosted
# Postgres provider (Neon, Supabase, Render Postgres, Prisma Postgres, etc).
# Most providers require SSL — include `?sslmode=require` if yours does.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js session encryption secret. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production — the app will not start without it.
AUTH_SECRET=""
