# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string (Prisma datasource). Works with any hosted
# Postgres provider (Neon, Supabase, Render Postgres, Prisma Postgres, etc).
# Most providers require SSL — include `?sslmode=require` if yours does.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js session encryption secret. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production — the app will not start without it.
AUTH_SECRET=""

# Stripe test-mode setup. Add actual values in .env or Render's Environment
# settings. Rotate any secret key previously pasted into chat.
# Hosted Checkout uses the server key; a publishable key is not required.
STRIPE_SECRET_KEY=""
# Separate signing secret from the webhook endpoint (not an API key).
STRIPE_WEBHOOK_SECRET=""
# Public base URL for Checkout redirects. Local development: http://localhost:3000
# On Render, RENDER_EXTERNAL_URL is also supported automatically.
APP_URL=""
